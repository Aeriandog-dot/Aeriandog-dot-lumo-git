# Lumo 运行配置(复制为 .env 后在 shell 中设置,或直接命令行传参)
# 端口
LUMO_PORT=4780
# 管理员邮箱(后端据此判定管理员,可自定义)
LUMO_ADMIN=admin@lumo.local
# 开发验证码(仅开发方便用;正式环境置空并接入真实邮件)
LUMO_DEV_CODE=123456
# 运行环境:production 时登录页不显示验证码提示
NODE_ENV=development
# SMTP(配置后验证码发送真实邮件)
LUMO_SMTP_HOST=smtp.example.com
LUMO_SMTP_PORT=587
LUMO_SMTP_USER=
LUMO_SMTP_PASS=
LUMO_SMTP_FROM=Lumo <no-reply@你的域名>
LUMO_SMTP_SECURE=false

# 数据目录(部署时指向持久磁盘;默认项目内 data/)
# LUMO_DATA_DIR=/var/data/lumo

# 自动备份(秒/小时/保留份数)
LUMO_BACKUP_INIT_SECONDS=60
LUMO_BACKUP_HOURS=24
LUMO_BACKUP_KEEP=14
# 证据快照自动补拍
LUMO_ARCHIVE_INIT_SECONDS=20
LUMO_ARCHIVE_MINUTES=10
